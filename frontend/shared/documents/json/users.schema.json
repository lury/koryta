{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "displayName": {
      "type": "string"
    },
    "photoURL": {
      "type": "string"
    },
    "publicProfile": {
      "type": "boolean"
    },
    "teamMail": {
      "type": "boolean"
    },
    "notifications": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "newsletter": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "newsletterUpdated": {
      "type": "object",
      "properties": {
        "at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "via": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    }
  },
  "additionalProperties": {}
}
