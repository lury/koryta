{
  "title": "VoteDocument",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "nodeId": {
      "type": "string"
    },
    "extractionId": {
      "type": "string"
    },
    "userUid": {
      "type": "string"
    },
    "categoryVotes": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "number"
      }
    },
    "comment": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    }
  },
  "required": ["userUid", "categoryVotes"],
  "additionalProperties": {}
}
